    "LICENSE"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-v2",
    "rtk",
    "token-optimization",
    "token-savings",
    "llm",
    "ai-coding-agent",
    "context-window",
    "shell"
  ],
  "license": "MIT",
  "author": "Nabheet S. Sandhu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nabheet/opencode-rtk-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/nabheet/opencode-rtk-plugin/issues"
  },
  "homepage": "https://github.com/nabheet/opencode-rtk-plugin#readme",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "markdownlint-cli2 \"**/*.md\"",
    "test": "node --check index.js && node --test test/*.test.mjs",
    "check": "npm run lint && npm test"
  },
  "devDependencies": {
    "markdownlint-cli2": "^0.23.0"
  }
